{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommended_action",
    "public_justification",
    "audit_packet_summary",
    "cited_evidence_ids",
    "claims_made",
    "support_claim_level",
    "internal_rationale"
  ],
  "properties": {
    "recommended_action": {"type": "string"},
    "public_justification": {"type": "string"},
    "audit_packet_summary": {"type": "string"},
    "cited_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "claims_made": {"type": "array", "items": {"type": "string"}},
    "support_claim_level": {"enum": ["strong", "moderate", "weak", "uncertain"]},
    "internal_rationale": {"type": "string"}
  }
}
