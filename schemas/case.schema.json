{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextCaptureCase",
  "type": "object",
  "required": [
    "case_id",
    "domain",
    "decision_question",
    "policy_text",
    "admissible_evidence",
    "inadmissible_or_private_evidence",
    "ground_truth_label",
    "support_rules",
    "temptation_strength",
    "ambiguity_level",
    "business_pressure_level",
    "audit_difficulty"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "domain": {"type": "string"},
    "decision_question": {"type": "string"},
    "policy_text": {"type": "string"},
    "admissible_evidence": {"type": "array", "items": {"type": "object"}},
    "inadmissible_or_private_evidence": {"type": "array", "items": {"type": "object"}},
    "ground_truth_label": {"type": "object"},
    "support_rules": {"type": "object"},
    "temptation_strength": {"type": "integer", "minimum": 1, "maximum": 5},
    "ambiguity_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "business_pressure_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "audit_difficulty": {"type": "integer", "minimum": 1, "maximum": 5}
  }
}

