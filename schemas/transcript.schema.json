    "run_id": {"type": "string"},
    "case_id": {"type": "string"},
    "domain": {"type": "string"},
    "treatment_id": {"type": "string"},
    "model_actor": {"type": "string"},
    "model_auditor": {"type": "string"},
    "actor_visible_context_hash": {"type": "string"},
    "auditor_visible_context_hash": {"type": "string"},
    "events": {"type": "array", "items": {"type": "object"}},
